IPE400 esp 2.1m entre 136.6 et 128.6
*Bois 6 cm - C18
*Autostable
*Provisoire
*3 cm
# XLS=@"Données RIDO.xls"
# CONST=&xlsWS()
# CONST=&xlsLI(1,2,1) CONST=&xlsCO(1,1,1)
#TN = xlc(1,l_TN,c_Cote)
#FF = xlc(1,l_FF,c_Cote)
#NAPPE = xlc(1,l_Nappe,c_Cote)
#Z0 = xlc(1,l_Z0,c_Cote)
#Zf = xlc(1,l_Zf,c_Cote)
#I = xlc(1,4,6)
#esp = xlc(1,5,6)
#EI = 2.1*I/esp
#b = xlc(1,7,6)
#h = xlc(1,6,6)
#B = b+2*(h-b)*(h>=b)
Z0 0
Zf EI 0 xlc(1,8,6)
xlc(1,l_TN,c_Cote)
#C1 = 2*(xlc(1,12,6)*1000/xlc(1,12,7))^(4/3)/(EI^(1/3))
#P1 = 6*xlc(1,12,6)*1000/(4*0.6/3/b*(2.65*b/0.6)^xlc(1,12,7)+xlc(1,12,7))/esp
#P1 = (b>=0.6)*P1
#P1bis= 6*xlc(1,12,6)*1000/(4/3*2.65^xlc(1,12,7)+xlc(1,12,7))/esp
#P1bis = (b<0.6)*P1bis
#Re1 = min(C1;max(P1;P1bis))
xlc(1,12,2) xlc(1,12,4) xlc(1,12,5) 0 0 0 xlc(1,12,8) xlc(1,12,9)
+ xlc(1,12,10) xlc(1,12,11) Re1
#C2 = 2*(xlc(1,13,6)*1000/xlc(1,13,7))^(4/3)/(EI^(1/3))
#P2 = 6*xlc(1,13,6)*1000/(4*0.6/3/b*(2.65*b/0.6)^xlc(1,13,7)+xlc(1,13,7))/esp
#P2 = (b>=0.6)*P2
#P2bis= 6*xlc(1,13,6)*1000/(4/3*2.65^xlc(1,13,7)+xlc(1,13,7))/esp
#P2bis = (b<0.6)*P2bis
#Re2 = min(C2;max(P2;P2bis))
xlc(1,13,2) xlc(1,13,4) xlc(1,13,5) 0 0 0 xlc(1,13,8) xlc(1,13,9)
+ xlc(1,13,10) xlc(1,13,11) Re2
#C3 = 2*(xlc(1,14,6)*1000/xlc(1,14,7))^(4/3)/(EI^(1/3))
#P3 = 6*xlc(1,14,6)*1000/(4*0.6/3/b*(2.65*b/0.6)^xlc(1,14,7)+xlc(1,14,7))/esp
#P3 = (b>=0.6)*P3
#P3bis= 6*xlc(1,14,6)*1000/(4/3*2.65^xlc(1,14,7)+xlc(1,14,7))/esp
#P3bis = (b<0.6)*P3bis
#Re3 = min(C3;max(P3;P3bis))
xlc(1,14,2) xlc(1,14,4) xlc(1,14,5) 0 0 0 xlc(1,14,8) xlc(1,14,9)
+ xlc(1,14,10) xlc(1,14,11) Re3
#C4 = 2*(xlc(1,15,6)*1000/xlc(1,15,7))^(4/3)/(EI^(1/3))
#P4 = 6*xlc(1,15,6)*1000/(4*0.6/3/b*(2.65*b/0.6)^xlc(1,15,7)+xlc(1,15,7))/esp
#P4 = (b>=0.6)*P4
#P4bis= 6*xlc(1,15,6)*1000/(4/3*2.65^xlc(1,15,7)+xlc(1,15,7))/esp
#P4bis = (b<0.6)*P4bis
#Re4 = min(C4;max(P4;P4bis))
xlc(1,15,2) xlc(1,15,4) xlc(1,15,5) 0 0 0 xlc(1,15,8) xlc(1,15,9)
+ xlc(1,15,10) xlc(1,15,11) Re4
#C5 = 2*(xlc(1,16,6)*1000/xlc(1,16,7))^(4/3)/(EI^(1/3))
#P5 = 6*xlc(1,16,6)*1000/(4*0.6/3/b*(2.65*b/0.6)^xlc(1,16,7)+xlc(1,16,7))/esp
#P5 = (b>=0.6)*P5
#P5bis= 6*xlc(1,16,6)*1000/(4/3*2.65^xlc(1,16,7)+xlc(1,16,7))/esp
#P5bis = (b<0.6)*P5bis
#Re5 = min(C5;max(P5;P5bis))
xlc(1,16,2) xlc(1,16,4) xlc(1,16,5) 0 0 0 xlc(1,16,8) xlc(1,16,9)
+ xlc(1,16,10) xlc(1,16,11) Re5
NAPPE .05
*"Phase 1 - Excavation à FF
sub(1) TN 0.50 10.5 5
coe Z0 Zf min(1;(b+2*h)/esp)
ber(2) FF
rrc 1/1.35/1.1
cal(2)
*"Phase 1 - MEL
tel(0,1)
fap 1.00 1.35 1/1.10 1.00 1.00 1.50/1.35 1.35 1.00 1.00 1.00
*fap
1.00 1.00 1/1.10/1.35 1.00 1.00 1.50/1.35 1.00 1.00 1.00 1.00
cal(2)
*"Phase 1 - ELU
tel(0,0)
fap 1.00 1.35 1/1.10 1.00 1.00 1.50/1.35 1.35 1.00 1.00 1.00
*fap
1.00 1.00 1/1.10/1.35 1.00 1.00 1.50/1.35 1.00 1.00 1.00 1.00
cal(2)
fin
bIL
stop
